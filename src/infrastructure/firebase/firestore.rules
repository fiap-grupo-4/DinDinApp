rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsExistingDocument() {
      return isOwner(resource.data.userId);
    }

    function ownsIncomingDocument() {
      return isOwner(request.resource.data.userId);
    }

    function ownershipIsUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    function hasOnlyKeys(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function hasRequiredKeys(data, required) {
      return data.keys().hasAll(required);
    }

    function isShortString(value, min, max) {
      return value is string
        && value.trim().size() >= min
        && value.size() <= max;
    }

    function isPositiveInt(value) {
      return value is int && value > 0 && value <= 1000000000000;
    }

    function isValidCategory(data) {
      return hasOnlyKeys(data, ['userId', 'name', 'createdAt', 'active'])
        && hasRequiredKeys(data, ['userId', 'name', 'createdAt'])
        && isShortString(data.name, 1, 60)
        && data.createdAt is string
        && (!('active' in data) || data.active is bool);
    }

    function categoryIsOwned(categoryId) {
      return categoryId == null || (
        categoryId is string
        && exists(/databases/$(database)/documents/categories/$(categoryId))
        && get(/databases/$(database)/documents/categories/$(categoryId)).data.userId == request.auth.uid
      );
    }

    function isValidReceipt(value, userId) {
      return value is string
        && value.size() <= 2048
        && (
          (
            value.matches('https://firebasestorage.googleapis.com/v0/b/.*/o/receipts%2F.*')
            && value.split('%2F').size() == 3
            && value.split('%2F')[1] == userId
          )
          || (
            value.split('/').size() == 3
            && value.split('/')[0] == 'receipts'
            && value.split('/')[1] == userId
            && value.split('/')[2].matches('[0-9]+-[a-z0-9]+\\.(jpg|jpeg|png|webp|heic)')
          )
        );
    }

    function isValidTransaction(data) {
      return hasOnlyKeys(data, [
          'userId',
          'valueInCents',
          'transactionType',
          'createdAt',
          'description',
          'categoryId',
          'receipt'
        ])
        && hasRequiredKeys(data, [
          'userId',
          'valueInCents',
          'transactionType',
          'createdAt'
        ])
        && isPositiveInt(data.valueInCents)
        && data.transactionType in ['income', 'outcome']
        && data.createdAt is string
        && (!('description' in data) || isShortString(data.description, 1, 200))
        && (!('categoryId' in data) || categoryIsOwned(data.categoryId))
        && (!('receipt' in data) || isValidReceipt(data.receipt, data.userId));
    }

    function isValidSavingsGoal(data) {
      return hasOnlyKeys(data, [
          'userId',
          'title',
          'currentValueInCents',
          'targetValueInCents',
          'createdAt'
        ])
        && hasRequiredKeys(data, [
          'userId',
          'title',
          'currentValueInCents',
          'targetValueInCents',
          'createdAt'
        ])
        && isShortString(data.title, 3, 80)
        && isPositiveInt(data.targetValueInCents)
        && data.currentValueInCents is int
        && data.currentValueInCents >= 0
        && data.currentValueInCents <= data.targetValueInCents
        && data.createdAt is string;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasOnlyKeys(request.resource.data, [
          'uid',
          'email',
          'fullName',
          'birthday',
          'createdAt'
        ])
        && hasRequiredKeys(request.resource.data, [
          'uid',
          'email',
          'fullName',
          'birthday',
          'createdAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && isShortString(request.resource.data.fullName, 3, 100)
        && request.resource.data.birthday is string
        && request.resource.data.birthday.size() <= 10
        && (
          request.resource.data.birthday == ''
          || request.resource.data.birthday.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        )
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'birthday'])
        && isShortString(request.resource.data.fullName, 3, 100)
        && request.resource.data.birthday is string
        && request.resource.data.birthday.size() <= 10
        && (
          request.resource.data.birthday == ''
          || request.resource.data.birthday.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        );
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow create: if isVerified()
        && ownsIncomingDocument()
        && isValidCategory(request.resource.data);
      allow get: if ownsExistingDocument();
      allow delete: if isVerified() && ownsExistingDocument();
      allow list: if ownsExistingDocument()
        && request.query.limit != null
        && request.query.limit <= 100;
      allow update: if isVerified()
        && ownsExistingDocument()
        && ownsIncomingDocument()
        && ownershipIsUnchanged()
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidCategory(request.resource.data);
    }

    match /transactions/{transactionId} {
      allow create: if isVerified()
        && ownsIncomingDocument()
        && isValidTransaction(request.resource.data);
      allow get: if ownsExistingDocument();
      allow delete: if isVerified() && ownsExistingDocument();
      allow list: if ownsExistingDocument()
        && request.query.limit != null
        && request.query.limit <= 100;
      allow update: if isVerified()
        && ownsExistingDocument()
        && ownsIncomingDocument()
        && ownershipIsUnchanged()
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidTransaction(request.resource.data);
    }

    match /savingsGoals/{savingsGoalId} {
      allow create: if isVerified()
        && ownsIncomingDocument()
        && isValidSavingsGoal(request.resource.data);
      allow get: if ownsExistingDocument();
      allow delete: if isVerified() && ownsExistingDocument();
      allow list: if ownsExistingDocument()
        && request.query.limit != null
        && request.query.limit <= 100;
      allow update: if isVerified()
        && ownsExistingDocument()
        && ownsIncomingDocument()
        && ownershipIsUnchanged()
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidSavingsGoal(request.resource.data);
    }
  }
}
