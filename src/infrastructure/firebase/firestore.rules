rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsExistingDocument() {
      return isOwner(resource.data.userId);
    }

    function ownsIncomingDocument() {
      return isOwner(request.resource.data.userId);
    }

    function ownershipIsUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && ownershipIsUnchanged();
    }

    match /transactions/{transactionId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && ownershipIsUnchanged();
    }

    match /savingsGoals/{savingsGoalId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && ownershipIsUnchanged();
    }
  }
}
