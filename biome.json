{
	"$schema": "https://biomejs.dev/schemas/2.2.3/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"src/**",
			"!src/shared/ui",
			"!src/styles/global.css"
		]
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 120,
		"bracketSpacing": true,
		"useEditorconfig": true
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"useButtonType": "off",
				"noSvgWithoutTitle": "off",
				"useKeyWithClickEvents": "off",
				"useIframeTitle": "off",
				"noLabelWithoutControl": "off",
				"noStaticElementInteractions": "off"
			},
			"performance": {
				"noImgElement": "off"
			},
			"nursery": {
				"useSortedClasses": "off"
			},
			"suspicious": {
				"noArrayIndexKey": "off",
				"noExplicitAny": "warn",
				"noThenProperty": "off"
			},
			"style": {
				"useImportType": "off",
				"useExportType": "off"
			},
			"correctness": {
				"noUndeclaredVariables": "off",
				"useExhaustiveDependencies": "off"
			}
		},
		"includes": [
			"src/**",
			"!src/shared/ui",
			"!src/styles/global.css"
		]
	},
	"javascript": {
		"formatter": {
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "asNeeded",
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"quoteStyle": "single",
			"attributePosition": "auto",
			"bracketSpacing": true
		}
	},
	"css": {
		"parser": {
			"cssModules": false,
			"allowWrongLineComments": true
		}
	},
	"overrides": [
		{
			"includes": [
				"src/domain/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"react*",
											"react*/**",
											"@react-native*/**",
											"expo*",
											"expo*/**",
											"firebase",
											"firebase/**",
											"@rn-primitives/**",
											"lucide-react-native",
											"nativewind",
											"zod",
											"@application/**",
											"@/src/application/**",
											"**/application/**",
											"@infra/**",
											"@/src/infrastructure/**",
											"**/infrastructure/**",
											"@presentation/**",
											"@/src/presentation/**",
											"**/presentation/**",
											"@main/**",
											"@/src/main/**",
											"**/main/**",
											"@lib/**",
											"@/src/lib/**",
											"**/lib/**",
											"@shared/**",
											"@/src/shared/**",
											"**/shared/ui/**",
											"@/src/app/**",
											"zod/**",
											"**/app/**"
										],
										"message": "domain \u00e9 TypeScript puro: n\u00e3o importa framework, Firebase nem outras camadas."
									}
								]
							}
						},
						"noCommonJs": "error"
					}
				}
			}
		},
		{
			"includes": [
				"src/application/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"react*",
											"react*/**",
											"@react-native*/**",
											"expo*",
											"expo*/**",
											"firebase",
											"firebase/**",
											"@rn-primitives/**",
											"lucide-react-native",
											"nativewind",
											"zod",
											"@infra/**",
											"@/src/infrastructure/**",
											"**/infrastructure/**",
											"@presentation/**",
											"@/src/presentation/**",
											"**/presentation/**",
											"@main/**",
											"@/src/main/**",
											"**/main/**",
											"@lib/**",
											"@/src/lib/**",
											"**/lib/**",
											"@shared/**",
											"@/src/shared/**",
											"**/shared/ui/**",
											"@/src/app/**",
											"zod/**",
											"**/app/**"
										],
										"message": "application s\u00f3 depende de domain."
									}
								]
							}
						},
						"noCommonJs": "error"
					}
				}
			}
		},
		{
			"includes": [
				"src/infrastructure/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"react",
											"react/**",
											"@application/**",
											"@/src/application/**",
											"**/application/**",
											"@presentation/**",
											"@/src/presentation/**",
											"**/presentation/**",
											"@main/**",
											"@/src/main/**",
											"**/main/**",
											"@lib/**",
											"@/src/lib/**",
											"**/lib/**",
											"@shared/**",
											"@/src/shared/**",
											"**/shared/ui/**",
											"@/src/app/**"
										],
										"message": "infrastructure s\u00f3 depende de domain e do SDK externo."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/presentation/**",
				"src/shared/**",
				"src/lib/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@infra/**",
											"@/src/infrastructure/**",
											"**/infrastructure/**",
											"firebase",
											"firebase/**",
											"@main/**",
											"@/src/main/**",
											"**/main/**"
										],
										"message": "presentation n\u00e3o conhece a infraestrutura: use useRepositories()."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/app/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@infra/**",
											"@/src/infrastructure/**",
											"**/infrastructure/**",
											"firebase",
											"firebase/**"
										],
										"message": "As rotas n\u00e3o importam a infraestrutura: a composi\u00e7\u00e3o fica em src/main."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
